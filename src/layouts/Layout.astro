---
import { getLangFromUrl, useTranslations, getLocalizedPath } from '@/i18n/utils';
import { languages, type Locale } from '@/i18n/ui';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  pageType?: 'website' | 'article';
  isArticle?: boolean;
  articleSchema?: object;
  howToSchema?: object;
  faqSchema?: object;
  breadcrumbs?: Array<{ name: string; item: string }>;
  disableRootHreflang?: boolean;
}

const lang = getLangFromUrl(Astro.url) as Locale;
const t = useTranslations(lang);

const title = Astro.props.title || t('seo.title');
const description = Astro.props.description || t('seo.description');
const pageType = Astro.props.pageType || (Astro.props.isArticle ? 'article' : 'website');

const siteBase = 'https://extracttext.github.io';
const defaultCanonicalPath = lang === 'en' ? '/' : `/${lang}/`;
const rawCanonicalPath = Astro.props.canonicalPath ?? defaultCanonicalPath;
const normalizedCanonical = rawCanonicalPath.startsWith('/') ? rawCanonicalPath : `/${rawCanonicalPath}`;
const canonicalUrl = `${siteBase}${normalizedCanonical}`;
const ogImage = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

// Hreflang handling
const locales = Object.keys(languages) as Locale[];
let hreflangEntries: Array<{ hreflang: string; href: string }> = [];

if (Astro.props.disableRootHreflang) {
  hreflangEntries = [
    { hreflang: lang, href: canonicalUrl },
    { hreflang: 'x-default', href: canonicalUrl },
  ];
} else {
  hreflangEntries = locales.map((loc) => ({
    hreflang: loc,
    href: `${siteBase}${getLocalizedPath(loc, '/')}`,
  }));
  hreflangEntries.push({
    hreflang: 'x-default',
    href: `${siteBase}/`,
  });
}

// JSON-LD: WebApplication (Default for tools)
const defaultWebAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'ExtractText',
  alternateName: 'ExtractText OCR',
  url: siteBase,
  description: t('seo.description'),
  image: ogImage,
  screenshot: ogImage,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any (Web Browser)',
  browserRequirements: 'Requires JavaScript and WebAssembly support',
  featureList: [
    '100% Client-side Optical Character Recognition (OCR)',
    'Zero server uploads - 100% private and secure',
    'Multi-language text extraction (English, Spanish, Portuguese, German, French, Japanese)',
    'Drag and drop, file browsing, and clipboard image pasting (Ctrl+V / Cmd+V)',
    'Instant text editing, clipboard copy, and .txt download',
  ],
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  inLanguage: locales,
  creator: {
    '@type': 'Person',
    name: 'Kishara Dilshan',
    url: 'https://buymeacoffee.com/kisharadilz',
  },
};

// JSON-LD: Default HowTo
const defaultHowToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: t('howto.heading'),
  description: t('seo.description'),
  image: ogImage,
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: t('howto.step1.title'),
      text: t('howto.step1.desc'),
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: t('howto.step2.title'),
      text: t('howto.step2.desc'),
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: t('howto.step3.title'),
      text: t('howto.step3.desc'),
    },
  ],
};

// JSON-LD: Default FAQPage
const defaultFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: t('faq.q1'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a1') } },
    { '@type': 'Question', name: t('faq.q2'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a2') } },
    { '@type': 'Question', name: t('faq.q3'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a3') } },
    { '@type': 'Question', name: t('faq.q4'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a4') } },
    { '@type': 'Question', name: t('faq.q5'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a5') } },
    { '@type': 'Question', name: t('faq.q6'), acceptedAnswer: { '@type': 'Answer', text: t('faq.a6') } },
  ],
};

// JSON-LD: BreadcrumbList
let breadcrumbItemList: Array<{ '@type': string; position: number; name: string; item: string }> = [];

if (Astro.props.breadcrumbs && Astro.props.breadcrumbs.length > 0) {
  breadcrumbItemList = Astro.props.breadcrumbs.map((bc, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: bc.name,
    item: bc.item.startsWith('http') ? bc.item : `${siteBase}${bc.item.startsWith('/') ? bc.item : `/${bc.item}`}`,
  }));
} else {
  breadcrumbItemList = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${siteBase}/`,
    },
  ];

  if (lang !== 'en') {
    breadcrumbItemList.push({
      '@type': 'ListItem',
      position: 2,
      name: languages[lang],
      item: canonicalUrl,
    });
  }
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbItemList,
};

// JSON-LD: Organization
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ExtractText',
  url: siteBase,
  logo: `${siteBase}/favicon.svg`,
  sameAs: ['https://buymeacoffee.com/kisharadilz'],
};

const activeArticleSchema = Astro.props.articleSchema;
const activeHowToSchema = Astro.props.howToSchema || (!Astro.props.isArticle ? defaultHowToSchema : undefined);
const activeFaqSchema = Astro.props.faqSchema || (!Astro.props.isArticle ? defaultFaqSchema : undefined);
---

<!doctype html>
<html lang={lang} class="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XC0P9VTYVJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-XC0P9VTYVJ');
    </script>

    <!-- Anti-FOUC: Default to Light mode; only apply dark if explicitly saved in localStorage -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={t('seo.keywords')} />
    <meta name="author" content="Kishara Dilshan" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Theme Color -->
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FDF4D2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#020617" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags -->
    {hreflangEntries.map((entry) => (
      <link rel="alternate" hreflang={entry.hreflang} href={entry.href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="ExtractText" />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <!-- JSON-LD Structured Data -->
    {!Astro.props.isArticle && (
      <script type="application/ld+json" set:html={JSON.stringify(defaultWebAppSchema)} />
    )}
    {activeArticleSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(activeArticleSchema)} />
    )}
    {activeHowToSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(activeHowToSchema)} />
    )}
    {activeFaqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(activeFaqSchema)} />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="min-h-screen bg-soft-cream text-dusty-rose dark:bg-slate-950 dark:text-slate-200 transition-colors duration-200">
    <slot />
  </body>
</html>
