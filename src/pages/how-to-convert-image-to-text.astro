---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const siteBase = 'https://extracttext.github.io';
const pageUrl = `${siteBase}/how-to-convert-image-to-text/`;
const ogImage = 'https://res.cloudinary.com/dpx6w78bt/image/upload/f_auto/q_auto/v1786342039/Online_Tool_rc1ybr.png';

const title = 'How to Convert Image to Text: The Complete Step-by-Step Guide (Free & Private)';
const description = 'Learn how to convert images, screenshots, and photos into clean, editable text for free. Step-by-step tutorial, OCR accuracy tips, method comparisons, and 100% private browser tools.';

// Structured Data: TechArticle
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'How to Convert Image to Text: The Complete Step-by-Step Guide',
  description: description,
  image: ogImage,
  author: {
    '@type': 'Person',
    name: 'Kishara Dilshan',
    url: 'https://buymeacoffee.com/kisharadilz',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ExtractText',
    url: siteBase,
    logo: {
      '@type': 'ImageObject',
      url: `${siteBase}/favicon.svg`,
    },
  },
  datePublished: '2026-09-18',
  dateModified: '2026-09-22',
  mainEntityOfPage: pageUrl,
};

// Structured Data: HowTo
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Convert Image to Text Online for Free',
  description: 'A simple 4-step walkthrough on extracting clean, editable text from any image using client-side OCR without uploading files to a server.',
  image: ogImage,
  totalTime: 'PT1M',
  step: [
    {
      '@type': 'HowToStep',
      position: 1,
      name: 'Upload or Paste Your Image',
      text: 'Drag and drop your JPG, PNG, WEBP, or screenshot directly into the converter, browse your local drive, or paste from clipboard using Ctrl+V or Cmd+V.',
      url: `${siteBase}/#step1`,
    },
    {
      '@type': 'HowToStep',
      position: 2,
      name: 'Select Document Language',
      text: 'Choose the primary language of the text in your image (English, Spanish, Portuguese, German, French, or Japanese) to optimize character recognition precision.',
      url: `${siteBase}/#step2`,
    },
    {
      '@type': 'HowToStep',
      position: 3,
      name: 'Extract Text Locally',
      text: 'Click Extract Text to trigger the client-side WebAssembly OCR engine. All character recognition happens directly in your browser without uploading to any remote server.',
      url: `${siteBase}/#step3`,
    },
    {
      '@type': 'HowToStep',
      position: 4,
      name: 'Edit, Copy, or Download',
      text: 'Review the recognized text in the interactive editor, make any fine edits, and click Copy to Clipboard or Download as .txt.',
      url: `${siteBase}/#step4`,
    },
  ],
};

// Structured Data: FAQPage
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is the fastest way to convert an image to text?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The fastest method is using a browser-based client-side OCR tool like ExtractText. You can paste an image directly with Ctrl+V (or Cmd+V on Mac) and extract the text in seconds without creating an account or waiting for server processing.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I convert images to text without uploading them to a server?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. ExtractText uses WebAssembly (Tesseract.js) to execute Optical Character Recognition directly inside your browser. Your images and extracted text never leave your computer or phone.',
      },
    },
    {
      '@type': 'Question',
      name: 'How can I copy text from a screenshot on Windows or Mac?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Capture your screen with Snipping Tool (Win + Shift + S on Windows) or Screenshot (Cmd + Shift + 4 on Mac). Then, open ExtractText and press Ctrl+V or Cmd+V to immediately paste and extract the text.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which image formats work best for OCR?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'PNG and high-resolution JPEG files generally yield the highest recognition accuracy because they preserve sharp letter contours. Clean WEBP, BMP, and TIFF formats also work well.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can OCR software recognize handwritten text?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Standard OCR models are trained primarily on printed and typed fonts. While neat, clear block handwriting can often be recognized, cursive or messy handwriting has lower accuracy compared to typed documents.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is ExtractText free to use?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes, ExtractText is 100% free with unlimited conversions, zero ads, and no registration or subscriptions required.',
      },
    },
  ],
};

const breadcrumbs = [
  { name: 'Home', item: '/' },
  { name: 'Guides', item: '/how-to-convert-image-to-text/' },
  { name: 'How to Convert Image to Text', item: '/how-to-convert-image-to-text/' },
];
---

<Layout
  title={title}
  description={description}
  canonicalPath="/how-to-convert-image-to-text/"
  pageType="article"
  isArticle={true}
  articleSchema={articleSchema}
  howToSchema={howToSchema}
  faqSchema={faqSchema}
  breadcrumbs={breadcrumbs}
  disableRootHreflang={true}
>
  <Header />

  <main class="py-10 px-4">
    <article class="mx-auto max-w-4xl">
      <!-- Breadcrumbs Navigation -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center flex-wrap gap-2 text-sm text-dusty-rose/70 dark:text-slate-400">
          <li>
            <a href="/" class="hover:text-dusty-rose dark:hover:text-slate-200 transition-colors font-medium">Home</a>
          </li>
          <li>
            <svg class="w-4 h-4 text-muted-purple/60 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li>
            <span class="text-dusty-rose/60 dark:text-slate-500">Guides</span>
          </li>
          <li>
            <svg class="w-4 h-4 text-muted-purple/60 dark:text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </li>
          <li aria-current="page" class="text-dusty-rose dark:text-slate-200 font-semibold truncate max-w-xs sm:max-w-none">
            How to Convert Image to Text
          </li>
        </ol>
      </nav>

      <!-- Article Header -->
      <header class="mb-10 pb-8 border-b border-muted-purple/20 dark:border-slate-800">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-sky-blue/20 dark:bg-muted-purple/20 text-dusty-rose dark:text-slate-200 mb-4">
          <span>📚 Comprehensive Guide</span>
          <span>•</span>
          <span>5 Min Read</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-dusty-rose dark:text-slate-100 mb-6 leading-tight">
          How to Convert Image to Text: The Complete Step-by-Step Guide
        </h1>
        <p class="text-lg sm:text-xl text-dusty-rose/80 dark:text-slate-300 leading-relaxed max-w-3xl">
          Everything you need to extract readable, editable text from pictures, scanned documents, and screenshots — completely free and 100% private inside your browser.
        </p>
        <div class="mt-6 flex items-center gap-4 text-sm text-dusty-rose/60 dark:text-slate-400">
          <span>By <strong>Kishara Dilshan</strong></span>
          <span>•</span>
          <time datetime="2026-09-22">Updated September 2026</time>
        </div>
      </header>

      <!-- Featured Snippet / Quick Summary Callout -->
      <section class="mb-12 rounded-2xl p-6 sm:p-8 bg-white dark:bg-slate-900 border-2 border-sky-blue/60 dark:border-muted-purple/40 shadow-sm">
        <div class="flex items-start gap-4">
          <div class="hidden sm:flex w-10 h-10 rounded-lg bg-sky-blue/20 dark:bg-muted-purple/20 items-center justify-center shrink-0 text-dusty-rose dark:text-slate-200 font-bold">
            💡
          </div>
          <div>
            <h2 class="text-lg sm:text-xl font-bold text-dusty-rose dark:text-slate-100 mb-2">
              Quick Answer: How to Convert Image to Text in 4 Steps
            </h2>
            <p class="text-sm sm:text-base text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-4">
              To convert an image to text online without installing software or registering:
            </p>
            <ol class="list-decimal pl-5 space-y-1.5 text-sm sm:text-base text-dusty-rose/90 dark:text-slate-200">
              <li>Open <strong><a href="/" class="underline text-sky-blue dark:text-muted-purple hover:brightness-95">ExtractText.github.io</a></strong> in any modern desktop or mobile browser.</li>
              <li><strong>Upload, drag & drop, or paste</strong> your image directly with <kbd class="px-2 py-0.5 rounded bg-soft-cream dark:bg-slate-800 text-xs font-mono">Ctrl+V</kbd> (or <kbd class="px-2 py-0.5 rounded bg-soft-cream dark:bg-slate-800 text-xs font-mono">⌘V</kbd> on Mac).</li>
              <li>Select your document's language and click <strong>Extract Text</strong>.</li>
              <li>Copy the extracted text to your clipboard or download it as a <kbd class="px-2 py-0.5 rounded bg-soft-cream dark:bg-slate-800 text-xs font-mono">.txt</kbd> file.</li>
            </ol>
            <div class="mt-5">
              <a
                href="/"
                class="inline-flex items-center gap-2 bg-sky-blue dark:bg-muted-purple text-slate-900 dark:text-white font-semibold rounded-lg px-5 py-2.5 text-sm hover:brightness-95 transition-all shadow-sm"
              >
                <span>Launch Free Converter Now</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Table of Contents -->
      <nav aria-label="Table of Contents" class="mb-12 rounded-xl p-6 bg-soft-cream/60 dark:bg-slate-900/40 border border-muted-purple/20 dark:border-slate-800">
        <h2 class="text-base font-bold uppercase tracking-wider text-dusty-rose dark:text-slate-200 mb-3">
          Table of Contents
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-dusty-rose/80 dark:text-slate-300">
          <li><a href="#what-is-ocr" class="hover:underline hover:text-dusty-rose dark:hover:text-white">1. What is Optical Character Recognition (OCR)?</a></li>
          <li><a href="#step-by-step" class="hover:underline hover:text-dusty-rose dark:hover:text-white">2. Step-by-Step Conversion Walkthrough</a></li>
          <li><a href="#methods-compared" class="hover:underline hover:text-dusty-rose dark:hover:text-white">3. Image to Text Methods Compared</a></li>
          <li><a href="#accuracy-tips" class="hover:underline hover:text-dusty-rose dark:hover:text-white">4. 6 Tips for 100% OCR Recognition Accuracy</a></li>
          <li><a href="#supported-formats" class="hover:underline hover:text-dusty-rose dark:hover:text-white">5. Supported Image Formats & Use Cases</a></li>
          <li><a href="#privacy-security" class="hover:underline hover:text-dusty-rose dark:hover:text-white">6. Why Client-Side Privacy Matters</a></li>
          <li><a href="#faq" class="hover:underline hover:text-dusty-rose dark:hover:text-white">7. Frequently Asked Questions</a></li>
        </ul>
      </nav>

      <!-- Section 1: What is OCR -->
      <section id="what-is-ocr" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-4">
          1. What is Optical Character Recognition (OCR)?
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-4">
          <strong>Optical Character Recognition (OCR)</strong> is a computational technology that analyzes digital images to identify geometric shapes resembling alphanumeric characters and symbols, translating them into machine-encoded, searchable, and editable text.
        </p>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-4">
          Historically, extracting text from images required cumbersome desktop software or expensive scanner hardware. Today, advances in <strong>WebAssembly (Wasm)</strong> and neural OCR engines (such as Tesseract) allow modern web browsers to process images locally inside your device without needing a remote cloud server.
        </p>
      </section>

      <!-- Section 2: Step-by-Step Walkthrough -->
      <section id="step-by-step" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-6">
          2. Step-by-Step: How to Extract Text from an Image
        </h2>

        <div class="space-y-6">
          <!-- Step 1 -->
          <div class="rounded-xl p-6 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-sky-blue dark:bg-muted-purple text-white font-bold flex items-center justify-center text-sm">
                1
              </span>
              <h3 class="text-xl font-bold text-dusty-rose dark:text-slate-100">
                Upload, Drag & Drop, or Paste Your Image
              </h3>
            </div>
            <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-3">
              Visit <a href="/" class="font-semibold underline text-dusty-rose dark:text-slate-100">ExtractText</a>. You have three quick ways to input your image:
            </p>
            <ul class="list-disc pl-6 space-y-1.5 text-dusty-rose/80 dark:text-slate-300 text-sm">
              <li><strong>Clipboard Paste (<kbd class="px-1.5 py-0.5 bg-soft-cream dark:bg-slate-800 rounded font-mono text-xs">Ctrl+V</kbd> / <kbd class="px-1.5 py-0.5 bg-soft-cream dark:bg-slate-800 rounded font-mono text-xs">⌘V</kbd>):</strong> Take a screenshot using your operating system's shortcut, then simply press paste anywhere on the page.</li>
              <li><strong>Drag and Drop:</strong> Drag any image file from your desktop or folder directly into the dashed dropzone area.</li>
              <li><strong>File Browser:</strong> Click anywhere inside the dropzone to browse your local files.</li>
            </ul>
          </div>

          <!-- Step 2 -->
          <div class="rounded-xl p-6 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-sky-blue dark:bg-muted-purple text-white font-bold flex items-center justify-center text-sm">
                2
              </span>
              <h3 class="text-xl font-bold text-dusty-rose dark:text-slate-100">
                Choose the Recognition Language
              </h3>
            </div>
            <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              In the dropdown menu above the dropzone, verify the OCR language matching your source image. ExtractText supports <strong>English, Spanish (Español), Portuguese (Português), German (Deutsch), French (Français), and Japanese (日本語)</strong>. Setting the right language loads specific neural dictionaries that dramatically increase symbol accuracy and accent recognition.
            </p>
          </div>

          <!-- Step 3 -->
          <div class="rounded-xl p-6 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-sky-blue dark:bg-muted-purple text-white font-bold flex items-center justify-center text-sm">
                3
              </span>
              <h3 class="text-xl font-bold text-dusty-rose dark:text-slate-100">
                Execute Instant Client-Side Extraction
              </h3>
            </div>
            <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              Click the prominent <strong>Extract Text</strong> button. A live progress bar will display the WebAssembly engine analyzing glyph boundaries, line segmentations, and baseline alignments. The processing typically finishes in <strong>1 to 3 seconds</strong>.
            </p>
          </div>

          <!-- Step 4 -->
          <div class="rounded-xl p-6 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <div class="flex items-center gap-3 mb-3">
              <span class="w-8 h-8 rounded-full bg-sky-blue dark:bg-muted-purple text-white font-bold flex items-center justify-center text-sm">
                4
              </span>
              <h3 class="text-xl font-bold text-dusty-rose dark:text-slate-100">
                Edit, Copy to Clipboard, or Export as .TXT
              </h3>
            </div>
            <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-3">
              Your extracted text populates immediately in an interactive textarea. You can edit any characters directly, fix formatting, and then:
            </p>
            <ul class="list-disc pl-6 space-y-1.5 text-dusty-rose/80 dark:text-slate-300 text-sm">
              <li>Click <strong>Copy to Clipboard</strong> to paste the text into Word, Google Docs, Notion, or WhatsApp.</li>
              <li>Click <strong>Download as .txt</strong> to save a clean text file directly to your downloads.</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Interactive Call to Action Banner -->
      <section class="mb-14 rounded-2xl p-8 bg-gradient-to-r from-sky-blue/30 via-muted-purple/20 to-soft-cream/50 dark:from-slate-900 dark:via-slate-850 dark:to-slate-900 border border-muted-purple/30 dark:border-slate-800 text-center">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-3">
          Ready to Extract Text from Your Image?
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 max-w-xl mx-auto mb-6 text-sm sm:text-base">
          No signups, no watermarks, and 100% private. Test it right now with any photo, document scan, or screenshot.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-sky-blue dark:bg-muted-purple text-slate-900 dark:text-white font-bold text-base px-6 py-3 rounded-lg hover:brightness-95 transition-all shadow-md hover:shadow-lg"
        >
          <span>Open ExtractText Free Converter</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </section>

      <!-- Section 3: Methods Compared -->
      <section id="methods-compared" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-4">
          3. Image-to-Text Methods Compared
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-6">
          Depending on your workflow, there are several ways to convert images to text. Here is how browser-based OCR compares against alternative solutions:
        </p>

        <div class="overflow-x-auto rounded-xl border border-muted-purple/20 dark:border-slate-800 mb-6">
          <table class="w-full text-left text-sm text-dusty-rose dark:text-slate-300">
            <thead class="bg-muted-purple/10 dark:bg-slate-800 text-xs uppercase font-bold text-dusty-rose dark:text-slate-200">
              <tr>
                <th class="p-3 sm:p-4">Method</th>
                <th class="p-3 sm:p-4">Privacy & Security</th>
                <th class="p-3 sm:p-4">Cost / Limits</th>
                <th class="p-3 sm:p-4">Ease of Use</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-muted-purple/10 dark:divide-slate-800">
              <tr class="bg-white/70 dark:bg-slate-900/80">
                <td class="p-3 sm:p-4 font-semibold text-dusty-rose dark:text-slate-100">
                  ExtractText (Client-Side Wasm)
                </td>
                <td class="p-3 sm:p-4 text-emerald-700 dark:text-emerald-400 font-medium">
                  🔒 100% Local (Zero uploads)
                </td>
                <td class="p-3 sm:p-4">100% Free / Unlimited</td>
                <td class="p-3 sm:p-4">Instant (Paste & go)</td>
              </tr>
              <tr class="bg-white/40 dark:bg-slate-900/40">
                <td class="p-3 sm:p-4 font-semibold">Cloud OCR Services (Google Lens, etc.)</td>
                <td class="p-3 sm:p-4 text-amber-700 dark:text-amber-400">Uploaded to third-party servers</td>
                <td class="p-3 sm:p-4">Free with Account / Paid APIs</td>
                <td class="p-3 sm:p-4">Requires login or app</td>
              </tr>
              <tr class="bg-white/70 dark:bg-slate-900/80">
                <td class="p-3 sm:p-4 font-semibold">Desktop Software (Acrobat Pro, ABBYY)</td>
                <td class="p-3 sm:p-4 text-emerald-700 dark:text-emerald-400">Local on machine</td>
                <td class="p-3 sm:p-4">Expensive ($15–$30/month)</td>
                <td class="p-3 sm:p-4">Heavy installation</td>
              </tr>
              <tr class="bg-white/40 dark:bg-slate-900/40">
                <td class="p-3 sm:p-4 font-semibold">OS Built-in Tools (Snipping Tool, Live Text)</td>
                <td class="p-3 sm:p-4 text-emerald-700 dark:text-emerald-400">Local</td>
                <td class="p-3 sm:p-4">Free (OS-locked)</td>
                <td class="p-3 sm:p-4">Limited language support</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 4: Accuracy Tips -->
      <section id="accuracy-tips" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-4">
          4. 6 Pro-Tips for 100% OCR Recognition Accuracy
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-6">
          OCR engines read pixels, not ideas. Following these best practices ensures near-flawless text recognition on receipts, contracts, books, and screenshots:
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">01.</span> Ensure High Contrast
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              Dark text on a pure white or bright background yields the highest recognition rates. Avoid colored text against textured or patterned backdrops.
            </p>
          </div>

          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">02.</span> Keep Proper Orientation (No Skew)
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              Rotate your photo so the text lines run straight horizontally. OCR engines struggle when text is angled past 15 degrees.
            </p>
          </div>

          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">03.</span> Aim for 300 DPI Resolution
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              For scanned paperwork, 300 DPI is the sweet spot. Images under 150 DPI produce fuzzy letter contours, confusing letters like "rn" with "m" or "cl" with "d".
            </p>
          </div>

          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">04.</span> Eliminate Shadow & Glare
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              When taking a phone photo of a paper document, position lighting from the sides rather than directly overhead to prevent phone shadows covering text.
            </p>
          </div>

          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">05.</span> Select the Correct Language Model
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              Always configure the OCR language dropdown to match the language in the picture to ensure accent marks (é, ü, ç, ñ) and character sets (Kanji, Kana) are parsed accurately.
            </p>
          </div>

          <div class="rounded-xl p-5 bg-white dark:bg-slate-900 border border-muted-purple/20 dark:border-slate-800">
            <h3 class="font-bold text-dusty-rose dark:text-slate-100 mb-2 flex items-center gap-2">
              <span class="text-sky-blue dark:text-muted-purple font-mono">06.</span> Crop Unnecessary Margins
            </h3>
            <p class="text-sm text-dusty-rose/80 dark:text-slate-300 leading-relaxed">
              Cropping out messy desk borders, hands, or surrounding background noise helps the OCR engine focus exclusively on the core text blocks.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Supported Formats & Use Cases -->
      <section id="supported-formats" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-4">
          5. Supported Image Formats & Common Use Cases
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-4">
          ExtractText supports all web-standard image formats: <strong>PNG, JPG, JPEG, WEBP, BMP, and GIF</strong>.
        </p>
        <div class="space-y-3 text-sm sm:text-base text-dusty-rose/80 dark:text-slate-300">
          <p>Common real-world use cases include:</p>
          <ul class="list-disc pl-6 space-y-2">
            <li><strong>Digital Screenshots:</strong> Copying code snippets, error messages, or YouTube video text where highlight selection is disabled.</li>
            <li><strong>Receipts & Invoices:</strong> Digitizing paper expense slips into spreadsheets or accounting tools.</li>
            <li><strong>Study Notes & Textbooks:</strong> Converting photo captures of library books into editable summaries.</li>
            <li><strong>Business Cards & Badges:</strong> Capturing contact names, emails, and phone numbers without manual typing.</li>
            <li><strong>Legal & Financial Documents:</strong> Extracting terms and agreements with complete privacy.</li>
          </ul>
        </div>
      </section>

      <!-- Section 6: Privacy & Security -->
      <section id="privacy-security" class="mb-12 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-4">
          6. Why Client-Side Privacy Matters
        </h2>
        <p class="text-dusty-rose/80 dark:text-slate-300 leading-relaxed mb-4">
          Most online image converters require you to upload your files to their backend servers. For invoices, bank statements, personal identification, medical records, or confidential workplace screenshots, this introduces major privacy and compliance risks (GDPR, HIPAA, CCPA).
        </p>
        <div class="rounded-xl p-6 bg-emerald-50 dark:bg-emerald-950/20 border border-emerald-300 dark:border-emerald-800 text-emerald-900 dark:text-emerald-300">
          <h3 class="font-bold text-base sm:text-lg mb-2 flex items-center gap-2">
            <span>🛡️</span> Zero Server Uploads Guarantee
          </h3>
          <p class="text-sm leading-relaxed">
            ExtractText runs <strong>100% inside your browser</strong> via compiled WebAssembly binaries. Your files never touch a cloud database or remote server. Even if your internet connection drops after loading the page, the OCR engine continues to process your images locally.
          </p>
        </div>
      </section>

      <!-- Section 7: FAQ Accordion -->
      <section id="faq" class="mb-14 scroll-mt-24">
        <h2 class="text-2xl sm:text-3xl font-bold text-dusty-rose dark:text-slate-100 mb-6">
          7. Frequently Asked Questions
        </h2>

        <div class="space-y-3">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group rounded-lg border border-muted-purple/20 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer px-5 py-4 text-left font-medium text-dusty-rose dark:text-slate-100 hover:bg-soft-cream/50 dark:hover:bg-slate-800/50 transition-colors select-none">
                <span>{faq.name}</span>
                <svg
                  class="w-5 h-5 shrink-0 ml-3 text-muted-purple dark:text-slate-400 transition-transform group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-4 pt-1 text-sm leading-relaxed text-dusty-rose/80 dark:text-slate-400 border-t border-muted-purple/10 dark:border-slate-800">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </section>

      <!-- Final Conversion Footer Box -->
      <section class="rounded-2xl p-8 bg-white dark:bg-slate-900 border border-muted-purple/30 dark:border-slate-800 text-center">
        <h2 class="text-2xl font-bold text-dusty-rose dark:text-slate-100 mb-3">
          Convert Your First Image in Seconds
        </h2>
        <p class="text-sm sm:text-base text-dusty-rose/80 dark:text-slate-300 max-w-lg mx-auto mb-6">
          Experience instant, secure client-side text recognition with zero setup.
        </p>
        <a
          href="/"
          class="inline-flex items-center gap-2 bg-sky-blue dark:bg-muted-purple text-slate-900 dark:text-white font-semibold rounded-lg px-6 py-3 hover:brightness-95 transition-all shadow-md"
        >
          <span>Go to OCR Converter</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </section>
    </article>
  </main>

  <Footer />
</Layout>
