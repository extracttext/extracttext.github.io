---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

const lang = getLangFromUrl(Astro.url) as Locale;
const t = useTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  class="theme-toggle-btn p-2 rounded-md text-dusty-rose dark:text-slate-300 hover:bg-muted-purple/10 dark:hover:bg-slate-800 transition-colors"
  aria-label={t('nav.theme.toggle')}
  title={t('nav.theme.toggle')}
>
  <!-- Sun icon: shown only in dark mode (click to switch to light) -->
  <svg
    class="w-5 h-5 hidden dark:block"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5" />
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
  </svg>
  <!-- Moon icon: shown only in light mode (click to switch to dark) -->
  <svg
    class="w-5 h-5 block dark:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
  </svg>
</button>
