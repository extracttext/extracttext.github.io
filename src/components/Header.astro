---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';
import ThemeToggle from './ThemeToggle.astro';
import LanguagePicker from './LanguagePicker.astro';

const lang = getLangFromUrl(Astro.url) as Locale;
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 w-full border-b border-muted-purple/30 dark:border-slate-800 bg-soft-cream/80 dark:bg-slate-950/80 backdrop-blur-md">
  <nav class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3">
    <!-- Brand -->
    <a
      href={lang === 'en' ? '/' : `/${lang}/`}
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-dusty-rose dark:text-slate-100 hover:opacity-80 transition-opacity"
    >
      <!-- Inline brand icon -->
      <svg width="28" height="28" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="100" height="100" rx="16" fill="#A290B7"/>
        <text x="50" y="66" text-anchor="middle" font-family="system-ui, sans-serif" font-weight="700" font-size="52" fill="#FDF4D2">T</text>
      </svg>
      {t('nav.brand')}
    </a>

    <!-- Desktop Actions -->
    <div class="hidden sm:flex items-center gap-3">
      <LanguagePicker />
      <ThemeToggle />
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#FFDD00] text-black hover:bg-[#FFDD00]/90 font-semibold rounded-md px-4 py-2 transition-colors text-sm"
      >
        {t('nav.support')}
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-btn"
      class="sm:hidden p-2 rounded-md text-dusty-rose dark:text-slate-200 hover:bg-muted-purple/10 transition-colors"
      aria-label="Toggle menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden sm:hidden border-t border-muted-purple/20 dark:border-slate-800 bg-soft-cream dark:bg-slate-950 px-4 pb-4 pt-3">
    <div class="flex flex-col gap-3">
      <div class="flex items-center justify-between">
        <LanguagePicker />
        <ThemeToggle />
      </div>
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-[#FFDD00] text-black hover:bg-[#FFDD00]/90 font-semibold rounded-md px-4 py-2 transition-colors text-sm text-center"
      >
        {t('nav.support')}
      </a>
    </div>
  </div>
</header>

<!-- Single script for mobile menu + theme toggle -->
<script is:inline>
  (function () {
    // Mobile menu
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', function () {
        menu.classList.toggle('hidden');
      });
    }

    // Theme toggle (handles ALL instances via data-theme-toggle)
    function toggleTheme() {
      var isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      } catch (_) {}
    }

    var toggleBtns = document.querySelectorAll('[data-theme-toggle]');
    for (var i = 0; i < toggleBtns.length; i++) {
      toggleBtns[i].addEventListener('click', toggleTheme);
    }
  })();
</script>
