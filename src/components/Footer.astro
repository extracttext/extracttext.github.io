---
import { getLangFromUrl, useTranslations, getLocalizedPath, getLocaleList, interpolate } from '@/i18n/utils';
import type { Locale } from '@/i18n/ui';

const lang = getLangFromUrl(Astro.url) as Locale;
const t = useTranslations(lang);
const locales = getLocaleList();
const year = new Date().getFullYear().toString();
---

<footer class="border-t border-muted-purple/20 dark:border-slate-800 bg-white/30 dark:bg-slate-900/50 py-10 px-4">
  <div class="mx-auto max-w-6xl">
    {/* Privacy callout */}
    <div class="flex items-center justify-center gap-2 mb-8 text-sm text-dusty-rose/80 dark:text-slate-400">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
        <path d="M7 11V7a5 5 0 0110 0v4" />
      </svg>
      <span>{t('footer.privacy')}</span>
    </div>

    {/* Language directory */}
    <div class="flex flex-wrap items-center justify-center gap-3 mb-6">
      {locales.map((locale) => (
        <a
          href={getLocalizedPath(locale.code, '/')}
          class:list={[
            'text-sm px-3 py-1 rounded-full transition-colors',
            locale.code === lang
              ? 'bg-sky-blue/20 dark:bg-muted-purple/20 text-dusty-rose dark:text-slate-100 font-medium'
              : 'text-dusty-rose/60 dark:text-slate-500 hover:text-dusty-rose dark:hover:text-slate-300 hover:bg-muted-purple/10 dark:hover:bg-slate-800',
          ]}
        >
          {locale.label}
        </a>
      ))}
    </div>

    {/* Bottom row */}
    <div class="flex flex-col sm:flex-row items-center justify-center gap-2 text-xs text-dusty-rose/60 dark:text-slate-500">
      <span>{interpolate(t('footer.copyright'), { year })}</span>
      <span class="hidden sm:inline">·</span>
      <a
        href="https://buymeacoffee.com/kisharadilz"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-dusty-rose dark:hover:text-slate-300 transition-colors"
      >
        {t('footer.developer')}
      </a>
    </div>
  </div>
</footer>
